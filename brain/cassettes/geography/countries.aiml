<?xml version="1.0" encoding="UTF-8"?>
<!-- FULL coverage: 195 countries (193 UN members + 2 observers: Vatican City, Palestine).
     The 30 entries verified individually via web search on 2026-10-17 are kept VERBATIM
     (8 predicates incl. population). The 165 new entries carry 7 predicates each — population
     is omitted because no verified static source was available; do not invent it.
     Sources for new entries: annexare Countries 3.1.1 (MIT; ISO 3166-1 names/capitals/currency
     codes/languages/continents) + pycountry 26.2.16 (ISO 3166-1 alpha-3, ISO 4217 currency names,
     ISO 639 language names). Corrections vs the dataset, verified 2026-10-18 on Wikipedia
     ISO 4217: Bulgaria BGN->EUR (lev withdrawn 2025-12-31, euro adopted), Cuba dropped
     withdrawn CUC (kept CUP), Sierra Leone SLL->SLE (redenomination 2022), Zimbabwe basket->ZWG
     (Zimbabwe Gold, 2024). Funds/unit-of-account codes dropped (BOV/CHE/CHW/CLF/USN/USS/UYI);
     multi-currency kept only where both circulate (BT/HT/LS/NA/PA/SV). Region follows the
     dataset continent (NA+SA=Americas, OC=Oceania); transcontinental states take the dataset
     classification (e.g. Kazakhstan=Asia). Excluded: Taiwan, Kosovo, Western Sahara and all
     territories (not UN members/observers). Drift-checked: all 30 verified entries match the
     dataset on capital/region/ISO codes; currency-name and language-list differences are
     documented conventions (sentence case, curated lists), not errors. -->
<module domain="geography" name="countries" version="2" source="annexare Countries 3.1.1 (MIT) + pycountry 26.2.16 ISO mappings + Wikipedia ISO 4217 corrections (2026-10-18); 30 entries individually verified via web search 2026-10-17, 165 dataset-derived; FULL coverage 195" confidence="1.0">
